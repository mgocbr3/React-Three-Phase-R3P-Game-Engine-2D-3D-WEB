{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixlPlayground Studio",
  "version": "0.1.0",
  "identifier": "com.pixlland.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "pnpm desktop:build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PixlPlayground Studio",
        "width": 1540,
        "height": 940,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
