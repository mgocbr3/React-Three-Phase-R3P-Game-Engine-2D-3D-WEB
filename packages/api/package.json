{
  "name": "@pixlland/engine-api",
  "private": true,
  "version": "0.0.1",
  "description": "PixlPlayground engine HTTP+WS server — REST routes for ops, WebSocket broadcaster for ProjectEvents (GDD §6.4).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pixl-api": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@pixlland/engine-ops": "workspace:*",
    "hono": "^4.12.22",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/ws": "^8.5.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
