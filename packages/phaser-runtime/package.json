{
  "name": "@pixlland/phaser-runtime",
  "private": true,
  "version": "0.0.1",
  "description": "PixlPlayground 2D runtime — Game/Scene/GameObject/Component over Phaser 4. Patterns adapted from PhaserEditor2D-v3 (MIT) where applicable.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.19.3",
    "@pixlland/engine-core": "workspace:*"
  },
  "peerDependencies": {
    "phaser": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
