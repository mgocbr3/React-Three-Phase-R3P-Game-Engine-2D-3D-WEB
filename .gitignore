# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Local reference engine mirrors (read-only mirrors of upstream repos
# used as source-of-truth for porting). Most are ignored — we don't
# want to bloat the repo with full upstream clones. EXCEPT:
# `tools/vendor/realism-effects/` is checked in because we maintain a
# patch (WebGLMultipleRenderTargets -> WebGLRenderTarget{count}) that
# must travel with the repo. See PATCH-NOTES.md inside.
tools/vendor/*
!tools/vendor/realism-effects
!tools/vendor/realism-effects/**

# Test/coverage
coverage/
.nyc_output/

# Runtime + logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Env
.env
.env.local
.env.*.local
.env.development.local
.env.production.local

# Vite
.vite/
